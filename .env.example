# Database Configuration (InfinityFree MySQL)
# Lihat host & password di Panel InfinityFree -> MySQL Databases
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_USER=if0_42858697
DB_PASSWORD=your_mysql_password
DB_NAME=if0_42858697_eduprogress

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang

# FTP Configuration (for InfinityFree deployment)
FTP_HOST=ftpupload.net
FTP_USER=if0_42858697
FTP_PASSWORD=your_ftp_password

# Frontend (Vite) - URL backend API
# Development: http://localhost:5000
# Production: isi URL server backend kamu
VITE_API_URL=http://localhost:5000
